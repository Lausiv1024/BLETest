<Window x:Class="BLETest.NewDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BLETest"
        mc:Ignorable="d" Initialized="Window_Initialized"
        Title="NewDeviceDialog" Height="450" Width="300" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="アプリでQRスキャンして登録"/>
            <Image x:Name="QrImg" Margin="10"/>
        </StackPanel>
        <Button x:Name="CancelButton" Content="キャンセル" HorizontalAlignment="Right" Grid.Row="1" Width="80" Margin="0,10,10,10" Click="CancelButton_Click"/>
    </Grid>
        
</Window>
